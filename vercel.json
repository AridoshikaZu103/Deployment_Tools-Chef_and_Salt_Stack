{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": {
      "root": "frontend"
    },
    "backend": {
      "root": "backend"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "@backend"
    },
    {
      "source": "/api",
      "destination": "@backend"
    },
    {
      "source": "/health",
      "destination": "@backend"
    },
    {
      "source": "/docs",
      "destination": "@backend"
    },
    {
      "source": "/openapi.json",
      "destination": "@backend"
    },
    {
      "source": "/(.*)",
      "destination": "@frontend"
    }
  ]
}